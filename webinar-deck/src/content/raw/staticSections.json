    "inner": "<div class=\"text-pane\">\n      <div class=\"eyebrow\">SEGMENT 01 &middot; REQUIREMENT GATHERING &middot; 5 MIN</div>\n      <h1 class=\"slide-title\" style=\"font-size:clamp(28px,3.6vw,44px);\">Five Ways<br/>to Gather</h1>\n      <div class=\"tech-list\">\n        <div class=\"tech-item tech-clickable\" data-tech=\"interview\">\n          <div class=\"tech-num\">1</div>\n          <div><div class=\"tech-name\">Interview <span class=\"tech-hint\">tutorial</span></div><div class=\"tech-desc\">Prepared questions, one person at a time, written down.</div></div>\n        </div>\n        <div class=\"tech-item tech-clickable\" data-tech=\"observation\">\n          <div class=\"tech-num\">2</div>\n          <div><div class=\"tech-name\">Observation <span class=\"tech-hint\">tutorial</span></div><div class=\"tech-desc\">Sit and watch the real work happen. Say nothing.</div></div>\n        </div>\n        <div class=\"tech-item tech-clickable\" data-tech=\"docstudy\">\n          <div class=\"tech-num\">3</div>\n          <div><div class=\"tech-name\">Document Study <span class=\"tech-hint\">tutorial</span></div><div class=\"tech-desc\">Collect every bill, register, form, and spreadsheet in use today.</div></div>\n        </div>\n        <div class=\"tech-item tech-clickable\" data-tech=\"prototype\">\n          <div class=\"tech-num\">4</div>\n          <div><div class=\"tech-name\">Prototype <span class=\"tech-hint\">tutorial</span></div><div class=\"tech-desc\">A clickable mock-up shown before any real code.</div></div>\n        </div>\n        <div class=\"tech-item tech-clickable\" data-tech=\"workshop\">\n          <div class=\"tech-num\">5</div>\n          <div><div class=\"tech-name\">Workshop <span class=\"tech-hint\">tutorial</span></div><div class=\"tech-desc\">Get the disagreeing departments in one room, facilitated.</div></div>\n        </div>\n      </div>\n      <div class=\"meta-row\" style=\"margin-top:20px;\">\n        <div class=\"meta-item\"><div class=\"meta-label\">SPEAKER</div><div class=\"meta-value\">Manikandan</div></div>\n        <div class=\"meta-item\"><div class=\"meta-label\">DURATION</div><div class=\"meta-value\">5 min</div></div>\n      </div>\n    </div>\n    <div class=\"canvas-pane\" data-scene-id=\"c3\"></div>"
  },
