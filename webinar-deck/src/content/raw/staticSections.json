    "inner": "<div class=\"text-pane\">\n      <div class=\"eyebrow\">SEGMENT 08 &middot; 10 MIN</div>\n      <h1 class=\"slide-title\" style=\"font-size:clamp(28px,3.6vw,44px);\">Live Question<br/>&amp; Answer</h1>\n      <div class=\"tech-list\">\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">1</div>\n          <div><div class=\"tech-name\">Submit via Pigeonhole</div><div class=\"tech-desc\">Anonymous is completely fine &mdash; ask whatever you actually want to know.</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">2</div>\n          <div><div class=\"tech-name\">Bring your own project</div><div class=\"tech-desc\">Share a decision or a project idea &mdash; we'll look at it live if time allows.</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">3</div>\n          <div><div class=\"tech-name\">Any panelist can answer</div><div class=\"tech-desc\">We'll route your question to whoever's expertise actually fits it.</div></div>\n        </div>\n      </div>\n      <div class=\"meta-row\" style=\"margin-top:16px;\">\n        <div class=\"meta-item\"><div class=\"meta-label\">PANEL</div><div class=\"meta-value\">All Speakers</div></div>\n        <div class=\"meta-item\"><div class=\"meta-label\">TIME</div><div class=\"meta-value\">12:00 &ndash; 12:10 PM</div></div>\n      </div>\n    </div>\n    <div class=\"canvas-pane\" data-scene-id=\"c12\"></div>"
  }
