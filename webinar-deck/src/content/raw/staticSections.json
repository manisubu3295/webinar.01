    "inner": "<div class=\"text-pane\">\n      <div class=\"eyebrow\">TODAY'S RUN OF SHOW</div>\n      <h1 class=\"slide-title\" style=\"font-size:clamp(28px,3.6vw,44px);\">What We're<br/>Covering</h1>\n      <div class=\"tech-list\">\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">1</div>\n          <div><div class=\"tech-name\">Requirement Gathering</div><div class=\"tech-desc\">9:50 &ndash; 10:10 AM &middot; 20 min</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">2</div>\n          <div><div class=\"tech-name\">Technology Selection</div><div class=\"tech-desc\">10:10 &ndash; 10:30 AM &middot; 20 min &middot; Frontend, Backend, How to Choose</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">3</div>\n          <div><div class=\"tech-name\">Database</div><div class=\"tech-desc\">10:30 &ndash; 10:50 AM &middot; 20 min</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">4</div>\n          <div><div class=\"tech-name\">Architecture</div><div class=\"tech-desc\">10:50 &ndash; 11:00 AM &middot; 10 min</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">5</div>\n          <div><div class=\"tech-name\">Build &amp; Testing</div><div class=\"tech-desc\">11:05 &ndash; 11:25 AM &middot; 20 min &middot; (5 min break beforehand)</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">6</div>\n          <div><div class=\"tech-name\">DevOps, Cloud &amp; Observability</div><div class=\"tech-desc\">11:25 &ndash; 11:45 AM &middot; 20 min</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">7</div>\n          <div><div class=\"tech-name\">Closing: Career Guidance</div><div class=\"tech-desc\">11:45 AM &ndash; 12:00 PM &middot; 15 min</div></div>\n        </div>\n        <div class=\"tech-item\">\n          <div class=\"tech-num\">8</div>\n          <div><div class=\"tech-name\">Live Question &amp; Answer</div><div class=\"tech-desc\">12:00 &ndash; 12:10 PM &middot; 10 min</div></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"canvas-pane\" data-scene-id=\"c1\"></div>"
