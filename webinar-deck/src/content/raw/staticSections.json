    "inner": "<div class=\"text-pane\">\n      <div class=\"sheet-stamp\"><span class=\"stamp-num\">01</span><span class=\"stamp-of\">of 8 modules</span></div>\n      <h1 class=\"divider-title\">Requirement Gathering</h1>\n      <p class=\"divider-desc\">How industry teams find out what a client actually needs, not just what they say.</p>\n      <div class=\"divider-contents\"><div class=\"divider-content-item\">Introduction</div><div class=\"divider-content-item\">Interview</div><div class=\"divider-content-item\">Observation</div><div class=\"divider-content-item\">Document Study</div><div class=\"divider-content-item\">Prototype</div><div class=\"divider-content-item\">Workshop</div></div>\n    </div>"
  },
