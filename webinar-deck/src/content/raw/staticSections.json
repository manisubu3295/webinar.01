    "inner": "<div class=\"text-pane\">\n      <div class=\"brand-line\">AADHIRAI INNOVATIONS</div>\n      <div class=\"brand-sub\">PERAVURANI &nbsp;&middot;&nbsp; CHENNAI &nbsp;&middot;&nbsp; SINGAPORE</div>\n      <div class=\"hero-title\">AAMEC</div>\n      <div class=\"hero-sub\">SESSION 01 &nbsp;|&nbsp; LIVE TECHNICAL WEBINAR</div>\n      <div class=\"hero-tag\">Live code. Live infrastructure. Live decisions.</div>\n      <div class=\"slide-desc\" style=\"max-width:56ch;\">\n        A fully live, hands-on build-through of a real enterprise application, from requirement gathering\n        to production operations. 18 September 2026, 9:50 AM to 12:10 PM IST.\n      </div>\n      <div class=\"panel-strip\">\n        <div class=\"panel-chip\"><div class=\"chip-circle\">MK</div><div><div class=\"chip-name\">Manikandan</div><div class=\"chip-role\">Session Lead</div></div></div>\n        <div class=\"panel-chip\"><div class=\"chip-circle\">MT</div><div><div class=\"chip-name\">Mathavan</div><div class=\"chip-role\">Data Architect</div></div></div>\n        <div class=\"panel-chip\"><div class=\"chip-circle\">KV</div><div><div class=\"chip-name\">Kalaivanan</div><div class=\"chip-role\">Infra &amp; DevOps Lead</div></div></div>\n        <div class=\"panel-chip\"><div class=\"chip-circle\">MN</div><div><div class=\"chip-name\">Mannan</div><div class=\"chip-role\">Product Owner</div></div></div>\n      </div>\n    </div>"
  },
